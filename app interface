elif page == "➕ Add / Update People":

    st.title("Add / Update People")

    tabs = st.tabs([
        "Add Person",
        "Edit Person",
        "Manage Relationships",
        "Delete Person"
    ])

    # -----------------------------------------------------
    # ADD
    # -----------------------------------------------------
    with tabs[0]:

        st.subheader("Add a new person")

        with st.form("add_person"):
            name = st.text_input("Name")
            age = st.number_input("Age", min_value=1, max_value=120, value=20)
            city = st.text_input("City")

            submitted = st.form_submit_button("Add Person")

            if submitted:
                if not name.strip():
                    st.error("Name is required.")
                else:
                    execute_query("""
                        INSERT INTO PERSON (name, age, city)
                        VALUES (%s, %s, %s)
                    """, (name.strip(), age, city.strip()))

                    st.success(f"{name} added successfully.")
                    st.rerun()

    # -----------------------------------------------------
    # EDIT
    # -----------------------------------------------------
    with tabs[1]:

        st.subheader("Edit person")

        people = run_query("""
            SELECT person_id, name, age, city
            FROM PERSON
            ORDER BY name
        """)

        if not people.empty:

            edit_options = {
                f"{row['name']} — ID {row['person_id']}": row["person_id"]
                for _, row in people.iterrows()
            }

            selected = st.selectbox(
                "Person",
                list(edit_options.keys()),
                key="edit_person"
            )

            row = people[people["person_id"] == edit_options[selected]].iloc[0]

            with st.form("edit_person_form"):

                new_name = st.text_input(
                    "Name",
                    value=row["name"]
                )

                new_age = st.number_input(
                    "Age",
                    min_value=1,
                    max_value=120,
                    value=int(row["age"])
                )

                new_city = st.text_input(
                    "City",
                    value=row["city"]
                )

                update = st.form_submit_button("Save Changes")

                if update:

                    execute_query("""
                        UPDATE PERSON
                        SET name = %s,
                            age = %s,
                            city = %s
                        WHERE person_id = %s
                    """, (
                        new_name,
                        new_age,
                        new_city,
                        int(row["person_id"])
                    ))

                    st.success("Person updated.")
                    st.rerun()

    # -----------------------------------------------------
    # RELATIONSHIPS
    # -----------------------------------------------------
    with tabs[2]:

        st.subheader("Manage friendships")

        people = run_query("""
            SELECT person_id, name
            FROM PERSON
            ORDER BY name
        """)

        if len(people) >= 2:

            c1, c2 = st.columns(2)

            with c1:
                person_options = {
                    f"{row['name']} — ID {row['person_id']}": row["person_id"]
                    for _, row in people.iterrows()
                }

                p1 = st.selectbox(
                    "Person 1",
                    list(person_options.keys()),
                    key="friend_p1"
                )

            with c2:
                p2 = st.selectbox(
                    "Person 2",
                    list(person_options.keys()),
                    key="friend_p2"
                )

            date = st.date_input("Friendship since")

            if st.button("Add Friendship"):

                id1 = int(person_options[p1])
                id2 = int(person_options[p2])

                if id1 == id2:
                    st.error("Choose two different people.")
                else:
                    try:
                        execute_query("""
                            INSERT INTO FRIENDSHIP
                            (person1_id, person2_id, since_date)
                            VALUES (%s, %s, %s)
                        """, (id1, id2, date))

                        st.success("Friendship added.")
                        st.rerun()

                    except mysql.connector.Error as e:
                        st.error(f"Could not add friendship: {e}")

    # -----------------------------------------------------
    # DELETE
    # -----------------------------------------------------
    with tabs[3]:

        st.subheader("Delete person")

        people = run_query("""
            SELECT person_id, name
            FROM PERSON
            ORDER BY name
        """)

        if not people.empty:

            delete_options = {
                f"{row['name']} — ID {row['person_id']}": row["person_id"]
                for _, row in people.iterrows()
            }

            selected = st.selectbox(
                "Person to delete",
                list(delete_options.keys()),
                key="delete_person"
            )

            if st.button("Delete Person", type="primary"):

                pid = int(delete_options[selected])

                try:
                    execute_query(
                        "DELETE FROM PERSON WHERE person_id = %s",
                        (pid,)
                    )

                    st.success("Person deleted.")
                    st.rerun()

                except mysql.connector.Error as e:
                    st.error(
                        "Cannot delete this person because related "
                        f"records still exist: {e}"
                    )


