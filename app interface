elif page == "✨ My Social Life":

    st.title("My Social Life")
    st.caption("Discover patterns hidden inside the relational database.")

    # Tabs keep the whole section compact — no endless scrolling.
    tabs = st.tabs([
        "🔗 Shared Interests",
        "✨ Potential Connections",
        "👥 Community Connectors",
        "📊 Most Connected",
        "🗄️ DB Snapshot"
    ])

    # -----------------------------------------------------
    # SHARED INTERESTS
    # -----------------------------------------------------
    with tabs[0]:

        st.subheader("Shared Interests")

        df = run_query("""
            SELECT
                p1.name AS person_1,
                p2.name AS person_2,
                COUNT(DISTINCT pi1.interest_id) AS shared_interests
            FROM PERSON_INTEREST pi1
            JOIN PERSON_INTEREST pi2
                ON pi1.interest_id = pi2.interest_id
               AND pi1.person_id < pi2.person_id
            JOIN PERSON p1
                ON p1.person_id = pi1.person_id
            JOIN PERSON p2
                ON p2.person_id = pi2.person_id
            GROUP BY p1.person_id, p2.person_id, p1.name, p2.name
            ORDER BY shared_interests DESC;
        """)

        st.dataframe(
            df,
            use_container_width=True,
            hide_index=True
        )

    # -----------------------------------------------------
    # POTENTIAL CONNECTIONS
    # -----------------------------------------------------
    with tabs[1]:

        st.subheader("Potential Connections")
        st.caption("People who share interests but are not already friends.")

        df = run_query("""
            SELECT
                p1.name AS person_1,
                p2.name AS person_2,
                COUNT(DISTINCT pi1.interest_id) AS shared_interests
            FROM PERSON_INTEREST pi1
            JOIN PERSON_INTEREST pi2
                ON pi1.interest_id = pi2.interest_id
               AND pi1.person_id < pi2.person_id
            JOIN PERSON p1
                ON p1.person_id = pi1.person_id
            JOIN PERSON p2
                ON p2.person_id = pi2.person_id
            WHERE NOT EXISTS (
                SELECT 1
                FROM FRIENDSHIP f
                WHERE
                    (f.person1_id = pi1.person_id
                     AND f.person2_id = pi2.person_id)
                    OR
                    (f.person1_id = pi2.person_id
                     AND f.person2_id = pi1.person_id)
            )
            GROUP BY
                p1.person_id,
                p2.person_id,
                p1.name,
                p2.name
            ORDER BY shared_interests DESC;
        """)

        st.dataframe(
            df,
            use_container_width=True,
            hide_index=True
        )

    # -----------------------------------------------------
    # COMMUNITY CONNECTORS
    # -----------------------------------------------------
    with tabs[2]:

        st.subheader("Community Connectors")
        st.caption("People connected through the same communities.")

        df = run_query("""
            SELECT
                c.community_name,
                COUNT(DISTINCT m.person_id) AS members
            FROM COMMUNITY c
            LEFT JOIN MEMBERSHIP m
                ON c.community_id = m.community_id
            GROUP BY c.community_id, c.community_name
            ORDER BY members DESC;
        """)

        st.dataframe(
            df,
            use_container_width=True,
            hide_index=True
        )

    # -----------------------------------------------------
    # MOST CONNECTED
    # -----------------------------------------------------
    with tabs[3]:

        st.subheader("Most Connected People")

        df = run_query("""
            SELECT
                p.person_id,
                p.name,
                COUNT(f.friend_id) AS connections
            FROM PERSON p
            LEFT JOIN (
                SELECT person1_id AS person_id,
                       person2_id AS friend_id
                FROM FRIENDSHIP

                UNION ALL

                SELECT person2_id AS person_id,
                       person1_id AS friend_id
                FROM FRIENDSHIP
            ) f
                ON p.person_id = f.person_id
            GROUP BY p.person_id, p.name
            ORDER BY connections DESC, p.name;
        """)

        st.dataframe(
            df,
            use_container_width=True,
            hide_index=True
        )

    # -----------------------------------------------------
    # DATABASE SNAPSHOT
    # -----------------------------------------------------
    with tabs[4]:

        st.subheader("Database Snapshot")

        tables = [
            ("People", "PERSON"),
            ("Interests", "INTEREST"),
            ("Friendships", "FRIENDSHIP"),
            ("Events", "EVENT"),
            ("Event Attendance", "EVENT_ATTENDANCE"),
            ("Communities", "COMMUNITY"),
            ("Memberships", "MEMBERSHIP"),
            ("Person Interests", "PERSON_INTEREST")
        ]

        cols = st.columns(4)

        for i, (label, table) in enumerate(tables):

            count = run_query(
                f"SELECT COUNT(*) AS total FROM {table}"
            ).iloc[0]["total"]

            with cols[i % 4]:
                st.metric(label, int(count))

        st.divider()

        st.caption(
            "The application uses MySQL as the relational database "
            "and SQL queries to generate these insights."
        )