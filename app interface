if page == "🗂️ Master Table":

    st.title("Master Table")
    st.caption("Complete relational view of people and their connections.")

    query = """
    SELECT
        p.person_id,
        p.name,
        p.age,
        p.city,
        COUNT(DISTINCT pi.interest_id) AS interests,
        COUNT(DISTINCT ea.event_id) AS events,
        COUNT(DISTINCT m.community_id) AS communities
    FROM PERSON p
    LEFT JOIN PERSON_INTEREST pi
        ON p.person_id = pi.person_id
    LEFT JOIN EVENT_ATTENDANCE ea
        ON p.person_id = ea.person_id
    LEFT JOIN MEMBERSHIP m
        ON p.person_id = m.person_id
    GROUP BY p.person_id, p.name, p.age, p.city
    ORDER BY p.person_id;
    """

    df = run_query(query)

    c1, c2, c3, c4 = st.columns(4)

    c1.metric("People", len(df))
    c2.metric("Cities", df["city"].nunique() if not df.empty else 0)
    c3.metric("Interests", int(df["interests"].sum()) if not df.empty else 0)
    c4.metric("Communities", int(df["communities"].sum()) if not df.empty else 0)

    st.dataframe(
        df,
        use_container_width=True,
        hide_index=True
    )


