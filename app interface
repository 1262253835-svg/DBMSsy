elif page == "👤 Person Profile":

    st.title("Person Profile")

    people = run_query("""
        SELECT person_id, name, age, city
        FROM PERSON
        ORDER BY name
    """)

    if people.empty:
        st.warning("No people found.")
        st.stop()

    person_options = {
        f"{row['name']} — ID {row['person_id']}": row["person_id"]
        for _, row in people.iterrows()
    }

    selected_person = st.selectbox(
        "Select a person",
        list(person_options.keys())
    )

    pid = int(person_options[selected_person])
    person = people[people["person_id"] == pid].iloc[0]

    # -----------------------------------------------------
    # HEADER
    # -----------------------------------------------------
    st.subheader(f"{person['name']}")

    m1, m2, m3, m4 = st.columns(4)

    m1.metric("Age", person["age"])
    m2.metric("City", person["city"])

    interests_count = run_query("""
        SELECT COUNT(*) AS total
        FROM PERSON_INTEREST
        WHERE person_id = %s
    """, (pid,)).iloc[0]["total"]

    events_count = run_query("""
        SELECT COUNT(*) AS total
        FROM EVENT_ATTENDANCE
        WHERE person_id = %s
    """, (pid,)).iloc[0]["total"]

    m3.metric("Interests", int(interests_count))
    m4.metric("Events", int(events_count))

    # -----------------------------------------------------
    # ONE-SCROLL PROFILE GRID
    # -----------------------------------------------------
    st.divider()

    col1, col2, col3, col4 = st.columns(4)

    # INTERESTS
    with col1:
        st.markdown("### 🎯 Interests")

        interests = run_query("""
            SELECT i.interest_name
            FROM INTEREST i
            JOIN PERSON_INTEREST pi
                ON i.interest_id = pi.interest_id
            WHERE pi.person_id = %s
            ORDER BY i.interest_name
        """, (pid,))

        if interests.empty:
            st.caption("No interests")
        else:
            for x in interests["interest_name"]:
                st.write(f"• {x}")

    # FRIENDS
    with col2:
        st.markdown("### 🤝 Friends")

        friends = run_query("""
            SELECT DISTINCT p.person_id, p.name, p.city
            FROM PERSON p
            JOIN FRIENDSHIP f
                ON (
                    (f.person1_id = %s AND f.person2_id = p.person_id)
                    OR
                    (f.person2_id = %s AND f.person1_id = p.person_id)
                )
            WHERE p.person_id != %s
            ORDER BY p.name
        """, (pid, pid, pid))

        if friends.empty:
            st.caption("No friends")
        else:
            for _, r in friends.iterrows():
                st.write(f"• **{r['name']}**")
                st.caption(r["city"])

    # EVENTS
    with col3:
        st.markdown("### 📅 Events")

        events = run_query("""
            SELECT e.event_name, e.event_date, e.location
            FROM EVENT e
            JOIN EVENT_ATTENDANCE ea
                ON e.event_id = ea.event_id
            WHERE ea.person_id = %s
            ORDER BY e.event_date
        """, (pid,))

        if events.empty:
            st.caption("No events")
        else:
            for _, r in events.iterrows():
                st.write(f"• **{r['event_name']}**")
                st.caption(f"{r['location']}")

    # COMMUNITIES
    with col4:
        st.markdown("### 👥 Communities")

        communities = run_query("""
            SELECT c.community_name, m.join_date
            FROM COMMUNITY c
            JOIN MEMBERSHIP m
                ON c.community_id = m.community_id
            WHERE m.person_id = %s
            ORDER BY c.community_name
        """, (pid,))

        if communities.empty:
            st.caption("No communities")
        else:
            for _, r in communities.iterrows():
                st.write(f"• **{r['community_name']}**")
                st.caption(f"Joined: {r['join_date']}")

    # -----------------------------------------------------
    # SHARED INTERESTS
    # -----------------------------------------------------
    st.divider()

    st.markdown("### 🔗 Shared Interests")

    shared = run_query("""
        SELECT
            p2.name AS person,
            COUNT(*) AS shared_interests
        FROM PERSON_INTEREST pi1
        JOIN PERSON_INTEREST pi2
            ON pi1.interest_id = pi2.interest_id
        JOIN PERSON p2
            ON p2.person_id = pi2.person_id
        WHERE pi1.person_id = %s
          AND pi2.person_id != %s
        GROUP BY p2.person_id, p2.name
        ORDER BY shared_interests DESC, p2.name
    """, (pid, pid))

    if shared.empty:
        st.caption("No shared interests found.")
    else:
        st.dataframe(
            shared,
            use_container_width=True,
            hide_index=True
        )


